{
  "schema": 2,
  "api_version": "2026-03-10",
  "repository": "The-Plum-Team/Quick-Skin-Mod",
  "managed_rulesets": {
    "default_branch": "Quick Skin default branch",
    "release_tags": "Quick Skin immutable release tags"
  },
  "release_tag_pattern": "mc*-v*",
  "required_checks": [
    "Build and verify",
    "Packaged E2E gate"
  ],
  "required_check_integration_id": 5256389,
  "release_environment": {
    "name": "release",
    "reviewer": {
      "type": "User",
      "login": "AkaNebur",
      "id": 105746531
    },
    "wait_timer": 0,
    "prevent_self_review": false,
    "deployment_policies": [
      {
        "type": "tag",
        "name": "mc*-v*"
      },
      {
        "type": "branch",
        "name": "master"
      }
    ],
    "retired_deployment_policies": [
      {
        "type": "branch",
        "name": "*-and-*-*"
      }
    ]
  },
  "readiness": {
    "all_protected_branches": {
      ".github/workflows/build-gate.yml": [
        "pull_request:",
        "ready_for_review",
        "|| 'Build and verify' }}"
      ],
      ".github/workflows/on-demand-e2e.yml": [
        "pull_request:",
        "ready_for_review",
        "|| 'Packaged E2E gate' }}"
      ]
    },
    "default_branch": {
      ".github/workflows/refresh-release-status.yml": [
        "automation/refresh-release-status",
        "gh pr create"
      ]
    },
    "release_source": {
      ".github/workflows/sync-version-branches.yml": [
        "scripts/release/release_sources.py --kind mode",
        "version-branch porting is retired"
      ],
      ".github/workflows/mod-base-release.yml": [
        "workflow_dispatch:",
        "environment: ${{ needs.plan.outputs.environment }}",
        "release admit",
        "--environment \"$RELEASE_ENVIRONMENT\""
      ]
    }
  },
  "source_matrix": "release/release-matrix.json",
  "shared_release_workflow": ".github/workflows/mod-base-release.yml"
}
