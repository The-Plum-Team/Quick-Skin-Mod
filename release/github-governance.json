{
  "schema": 2,
  "api_version": "2026-03-10",
  "repository": "The-Plum-Team/Quick-Skin-Mod",
  "managed_rulesets": {
    "default_branch": "Quick Skin default branch",
    "release_tags": "Quick Skin immutable release tags"
  },
  "release_tag_pattern": "mc*-v*",
  "required_checks": [
    "Build and verify",
    "Packaged E2E gate"
  ],
  "release_environment": {
    "name": "release",
    "reviewer": {
      "type": "User",
      "login": "AkaNebur",
      "id": 105746531
    },
    "wait_timer": 0,
    "prevent_self_review": false,
    "deployment_policies": [
      {
        "type": "tag",
        "name": "mc*-v*"
      },
      {
        "type": "branch",
        "name": "master"
      }
    ],
    "retired_deployment_policies": [
      {
        "type": "branch",
        "name": "*-and-*-*"
      }
    ]
  },
  "readiness": {
    "all_protected_branches": {
      ".github/workflows/build-gate.yml": [
        "pull_request:",
        "name: Build and verify"
      ],
      ".github/workflows/on-demand-e2e.yml": [
        "pull_request:",
        "name: Packaged E2E gate"
      ]
    },
    "default_branch": {
      ".github/workflows/refresh-release-status.yml": [
        "automation/refresh-release-status",
        "gh pr create"
      ]
    },
    "release_source": {
      ".github/workflows/release.yml": [
        "environment: release",
        "github_release.py stage",
        "github_release.py publish",
        "--event-target",
        "--target \"$RELEASE_TARGET\"",
        "release-target: ${{ needs.build.outputs.target }}"
      ],
      ".github/workflows/sync-version-branches.yml": [
        "scripts/release/release_sources.py --kind mode",
        "version-branch porting is retired"
      ],
      ".github/workflows/release-recovery.yml": [
        "environment: release",
        "scripts/release/recover_sbom_release.py prepare",
        "scripts/release/recover_sbom_release.py verify",
        "needs.prepare.outputs.source_sha"
      ]
    }
  },
  "source_matrix": "release/release-matrix.json",
  "sbom_recovery_workflow": ".github/workflows/release-recovery.yml"
}
